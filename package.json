{
  "name": "harbor",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "author": "Excelius-Wang",
  "repository": {
    "type": "git",
    "url": "https://github.com/Excelius-Wang/harbor.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "release:version": "node scripts/release-version.mjs",
    "tauri": "dotenv -c -- tauri",
    "tauri:dev": "dotenv -c -- tauri dev",
    "tauri:build": "dotenv -c -- tauri build --bundles nsis",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "lint": "eslint src/**/*.{ts,tsx} vite.config.ts",
    "lint:fix": "eslint src/**/*.{ts,tsx} vite.config.ts --fix",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@shikijs/core": "4.4.3",
    "@shikijs/engine-javascript": "4.4.3",
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.102.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^25.8.18",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-diff-view": "^3.3.3",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.5.8",
    "react-markdown": "^10.1.0",
    "recharts": "3.8.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "style-to-object": "^1.0.14",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/hast": "^3.0.5",
    "@types/node": "^25.5.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "jsdom": "30.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
